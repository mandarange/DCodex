{
  "schema": "sks.desktop-bridge-hermetic-scenarios.v1",
  "providers": {
    "codex-lb": {
      "upstream_model": "Vendor/LB-Sandbox-Model",
      "route_key": "codex-lb:vendor/lb-sandbox-model"
    },
    "openrouter": {
      "upstream_model": "openrouter-sandbox-model",
      "route_key": "openrouter:openrouter-sandbox-model"
    }
  },
  "required_assertions": [
    "isolated_roots",
    "single_bridge_runtime",
    "simultaneous_provider_profiles",
    "explicit_route_index_no_fallback",
    "pin_affinity_tamper_fail_closed",
    "restart_generation_recovery",
    "ambient_credential_stripping",
    "write_confinement",
    "secret_free_output_and_state"
  ]
}
